# Bắt buộc: khóa mã hóa API key của provider (32 byte, base64).
# Tạo bằng: pnpm run key:generate
APP_ENCRYPTION_KEY=

# Cổng backend
PORT=8787

# Đường dẫn dữ liệu (tương đối tính từ thư mục dự án)
DATABASE_PATH=data/app.db
MEDIA_DIR=data/media

# Origin của ứng dụng, dùng để kiểm tra CSRF/Origin
APP_ORIGIN=http://127.0.0.1:5173

# Đặt true để cho phép Base URL nội bộ/LAN (chỉ dùng khi phát triển).
# Mặc định false để chặn SSRF.
ALLOW_PRIVATE_PROVIDER_URLS=false

# mock = provider giả lập cho test (không gọi mạng, không tốn phí)
# live = gọi provider thật bằng key người dùng
PROVIDER_MODE=live

# Giới hạn
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_PROMPT_LENGTH=8000
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200
MAX_USER_MEDIA_BYTES=1073741824

# Ảnh tham chiếu nhân vật và ảnh nguồn để tạo ảnh từ ảnh
MAX_REFERENCE_BYTES=5242880
MAX_SOURCE_IMAGE_BYTES=10485760
MAX_SOURCE_IMAGES=4
VIDEO_POLL_TIMEOUT_MS=1800000

# Bật cookie Secure (chỉ dùng khi chạy HTTPS)
COOKIE_SECURE=false

# Giới hạn tần suất (đặt 0 để tắt; chỉ nên tắt trong môi trường test)
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_LOGIN_PER_10MIN=10
RATE_LIMIT_GENERATE_PER_MIN=20
# Số lần gọi LLM sinh văn bản mỗi phút (tạo nhân vật bằng AI, tạo kịch bản)
RATE_LIMIT_LLM_CHAT_PER_MIN=10

# --- Xuất video (ghép các cảnh thành một video hoàn chỉnh) ---
# Đường dẫn tới ffmpeg. Để trống thì tìm trong PATH.
# Cần ffmpeg để xuất video; thiếu thì chức năng xuất báo lỗi kèm hướng dẫn cài.
FFMPEG_PATH=
# Thời gian tối đa cho một lần ghép video, tính bằng ms (mặc định 10 phút)
EXPORT_TIMEOUT_MS=600000
# Số cảnh tối đa cho một lần xuất video
EXPORT_MAX_SCENES=30
