# Dùng riêng cho Docker: cp .env.docker.example .env.docker && chmod 600 .env.docker
# Mọi lệnh Compose phải có: --env-file .env.docker
# KHÔNG commit file thật, KHÔNG dùng khóa mẫu, KHÔNG đổi khóa sau khi đã lưu API key.
# Sinh khóa không cần Node trên VPS:
# docker run --rm node:24-bookworm-slim node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Bắt buộc: email admin sẽ tự đăng ký lần đầu trên giao diện.
# Chưa có xác minh email: đăng ký admin qua SSH tunnel TRƯỚC khi bật Cloudflare.
SUPER_ADMIN_EMAILS=

# Bước 1: bootstrap an toàn qua localhost/SSH (chưa bật profile tunnel).
# Nếu đổi cổng localhost/SSH trên trình duyệt, sửa APP_ORIGIN cho khớp.
APP_ORIGIN=http://127.0.0.1:8787
COOKIE_SECURE=false
APP_LOCAL_PORT=8787
# Thời gian Docker chờ worker dừng; thường thoát ngay nếu không có tác vụ.
# Trước khi bảo trì, chờ tác vụ hoàn tất; không giảm khi đang xuất video.
APP_STOP_GRACE_PERIOD=1h

# Bước 2: trước khi public, sửa APP_ORIGIN=https://studio.example.com
# và COOKIE_SECURE=true. Origin không chứa đường dẫn hoặc dấu / cuối.
# Cloudflare Zero Trust: tạo tunnel, đặt service HTTP -> app:8787.
# Chỉ dán token, không dán toàn bộ lệnh "docker run ...".
# Có thể để trống khi chỉ chạy app; profile tunnel cần token hợp lệ để kết nối.
CLOUDFLARE_TUNNEL_TOKEN=
# Tùy chọn override image cloudflared đã ghim digest trong compose.yaml:
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:<version>@sha256:<digest>

PROVIDER_MODE=live
ALLOW_PRIVATE_PROVIDER_URLS=false

# Giới hạn vận hành (có thể chỉnh rồi chạy lại docker compose up -d).
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_PROMPT_LENGTH=8000
MAX_IMAGE_BYTES=52428800
MAX_VIDEO_BYTES=209715200
MAX_USER_MEDIA_BYTES=1073741824
MAX_REFERENCE_BYTES=5242880
MAX_SOURCE_IMAGE_BYTES=10485760
MAX_SOURCE_IMAGES=4
VIDEO_POLL_TIMEOUT_MS=1800000
IMAGE_REQUEST_TIMEOUT_MS=180000
TTS_REQUEST_TIMEOUT_MS=180000
MAX_AUDIO_BYTES=26214400

# Tuỳ chọn: nền cắt nền cục bộ bằng u2net CPU (vẫn giữ lựa chọn provider).
# Bật: đặt URL bên dưới rồi chạy
#   docker compose --env-file .env.docker --profile background-removal up -d --build
# Để trống và không bật profile để tắt. Dịch vụ không có cổng host, không ra internet.
BACKGROUND_REMOVAL_URL=
# BACKGROUND_REMOVAL_URL=http://background-removal:7000
BACKGROUND_REMOVAL_TIMEOUT_MS=120000
# Nhỏ hơn timeout backend để còn thời gian truyền ảnh.
BG_REMOVAL_TIMEOUT_SECONDS=110
BG_REMOVAL_MAX_SIDE=8192
BG_REMOVAL_MAX_PIXELS=25000000
BG_REMOVAL_MEMORY_LIMIT=2g
BG_REMOVAL_CPUS=1.0
# Số lần sidecar tự khởi động lại worker sau lỗi nặng (ví dụ timeout).
BG_REMOVAL_MAX_RESTARTS=3
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_LOGIN_PER_10MIN=10
RATE_LIMIT_GENERATE_PER_MIN=20
RATE_LIMIT_LLM_CHAT_PER_MIN=10
EXPORT_TIMEOUT_MS=600000
EXPORT_MAX_SCENES=30

# Compose cố định: PORT=8787, DATABASE_PATH=/app/data/app.db,
# MEDIA_DIR=/app/data/media, FFMPEG_PATH=/usr/bin/ffmpeg.
# Không cần cài SQLite, Node, pnpm hoặc ffmpeg trên host.
